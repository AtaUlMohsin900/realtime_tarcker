<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Real-Time Geolocation Tracking</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
    integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style>
    body {
      margin: 0;
      padding: 20px;
      font-family: Arial, sans-serif;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    header {
      text-align: center;
      margin-bottom: 20px;
    }

    h1 {
      color: #333;
      margin-bottom: 10px;
    }

    .status {
      background-color: #f5f5f5;
      padding: 10px;
      border-radius: 5px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    #connection-status {
      padding: 5px 10px;
      border-radius: 3px;
      font-weight: bold;
    }

    .connected {
      background-color: #4CAF50;
      color: white;
    }

    .disconnected {
      background-color: #f44336;
      color: white;
    }

    #map {
      height: 600px;
      width: 100%;
      border: 2px solid #ddd;
      border-radius: 8px;
    }

    .coordinates {
      margin-top: 10px;
      font-size: 14px;
      color: #666;
    }

    .marker-count {
      background-color: #2196F3;
      color: white;
      padding: 3px 8px;
      border-radius: 3px;
    }
  </style>
</head>

<body>
  <div class="container">
    <header>
      <h1>🌍 Real-Time Geolocation Tracking</h1>
      <p>Track your location and see others in real-time</p>
    </header>

    <div class="status">
      <div>
        <span>Your ID: <strong id="user-id">Loading...</strong></span>
        <span class="coordinates">
          Position: <span id="current-position">Not available</span>
        </span>
      </div>
      <div>
        <span id="connection-status" class="disconnected">Disconnected</span>
        <span class="marker-count">Markers: <span id="marker-count">0</span></span>
      </div>
    </div>

    <div id="map"></div>

    <div class="instructions">
      <h3>How it works:</h3>
      <ul>
        <li>The app tracks your location using browser geolocation</li>
        <li>Your position is shared in real-time with other users</li>
        <li>Each user appears as a marker on the map</li>
        <li>Open this page in multiple tabs/devices to see real-time updates</li>
      </ul>
    </div>
  </div>

  <!-- Leaflet JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"
    integrity="sha512-puJW3E/qXDqYp9IfhAI54BJEaWIfloJ7JWs7OeD5i6ruC9JZL1gERT1wjtwXFlh7CjE7ZJ+/vcRZRkIYIb6p4g=="
    crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <!-- Socket.io Client -->
  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"
    integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+"
    crossorigin="anonymous"></script>

  <script>
    // Initialize map
    const map = L.map('map').setView([0, 0], 15);

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    // Store markers by user ID
    const markers = {};
    let socket = null;
    let userId = null;
    let watchId = null;

    // Initialize Socket.io connection
    function initSocket() {
      socket = io();

      socket.on('connect', () => {
        console.log('Connected to server with ID:', socket.id);
        document.getElementById('connection-status').className = 'connected';
        document.getElementById('connection-status').textContent = 'Connected';
        userId = socket.id;
        document.getElementById('user-id').textContent = userId;

        // Request location permission after connection
        requestGeolocation();
      });

      socket.on('disconnect', () => {
        console.log('Disconnected from server');
        document.getElementById('connection-status').className = 'disconnected';
        document.getElementById('connection-status').textContent = 'Disconnected';
      });

      socket.on('message', (message) => {
        console.log('Server message:', message);
      });

      // Handle location updates from other users
      socket.on('receive-location', (data) => {
        updateOrCreateMarker(data.id, data.latitude, data.longitude);
      });

      // Handle existing users when connecting
      socket.on('existing-users', (users) => {
        users.forEach(user => {
          updateOrCreateMarker(user.id, user.latitude, user.longitude);
        });
      });

      // Handle user disconnection
      socket.on('user-disconnected', (userId) => {
        removeMarker(userId);
      });

      socket.on('user-connected', (userId) => {
        console.log('New user connected:', userId);
      });
    }

    // Check if browser supports geolocation
    function requestGeolocation() {
      if (!navigator.geolocation) {
        alert("Geolocation is not supported by your browser");
        return;
      }

      // Set geolocation options
      const options = {
        enableHighAccuracy: true,  // Request high accuracy
        timeout: 5000,             // 5 second timeout
        maximumAge: 0              // No caching, get fresh position
      };

      // Use watchPosition for continuous tracking
      watchId = navigator.geolocation.watchPosition(
        (position) => {
          const { latitude, longitude } = position.coords;

          // Update display
          document.getElementById('current-position').textContent =
            `${latitude.toFixed(6)}, ${longitude.toFixed(6)}`;

          // Center map on user's position
          map.setView([latitude, longitude], 15);

          // Update user's own marker
          updateOrCreateMarker(userId, latitude, longitude, true);

          // Emit location via socket
          if (socket) {
            socket.emit('send-location', {
              latitude,
              longitude,
              accuracy: position.coords.accuracy
            });
          }
        },
        (error) => {
          console.error('Geolocation error:', error);
          switch (error.code) {
            case error.PERMISSION_DENIED:
              alert("Location permission denied. Please enable location services.");
              break;
            case error.POSITION_UNAVAILABLE:
              alert("Location information is unavailable.");
              break;
            case error.TIMEOUT:
              alert("Location request timed out.");
              break;
            default:
              alert("An unknown error occurred.");
          }
        },
        options
      );

      console.log('Geolocation tracking started with watchId:', watchId);
    }

    // Update or create marker for a user
    function updateOrCreateMarker(id, lat, lng, isCurrentUser = false) {
      if (markers[id]) {
        // Update existing marker position
        markers[id].setLatLng([lat, lng]);
      } else {
        // Create new marker with custom icon
        const icon = L.divIcon({
          html: `<div style="
            background-color: ${isCurrentUser ? '#FF0000' : '#2196F3'};
            width: 15px;
            height: 15px;
            border-radius: 50%;
            border: 2px solid white;
            box-shadow: 0 0 5px rgba(0,0,0,0.5);
          "></div>`,
          className: 'custom-marker',
          iconSize: [19, 19],
          iconAnchor: [9.5, 9.5]
        });

        markers[id] = L.marker([lat, lng], { icon }).addTo(map);

        // Add popup with user ID
        markers[id].bindPopup(`<b>${isCurrentUser ? 'You' : 'User'}</b><br>ID: ${id}<br>Lat: ${lat.toFixed(6)}<br>Lng: ${lng.toFixed(6)}`);

        // Update marker count
        updateMarkerCount();
      }

      // Center map if it's the current user
      if (isCurrentUser) {
        map.setView([lat, lng], 15);
      }
    }

    // Remove marker when user disconnects
    function removeMarker(id) {
      if (markers[id]) {
        map.removeLayer(markers[id]);
        delete markers[id];
        console.log('Removed marker for user:', id);
        updateMarkerCount();
      }
    }

    // Update marker count display
    function updateMarkerCount() {
      const count = Object.keys(markers).length;
      document.getElementById('marker-count').textContent = count;
    }

    // Cleanup function
    function cleanup() {
      if (watchId !== null) {
        navigator.geolocation.clearWatch(watchId);
        console.log('Geolocation tracking stopped');
      }

      // Clear all markers
      Object.keys(markers).forEach(id => {
        map.removeLayer(markers[id]);
      });

      if (socket) {
        socket.disconnect();
      }
    }

    // Initialize when page loads
    window.addEventListener('DOMContentLoaded', () => {
      initSocket();
    });

    // Cleanup on page unload
    window.addEventListener('beforeunload', cleanup);
  </script>
</body>

</html>